# Database
DATABASE_URL="postgresql://user:password@localhost:5432/service_site?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_SLUG="summit-roofing"

# AI site editor (OpenAI-compatible)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Lead notifications — Resend (preferred)
RESEND_API_KEY=""
LEAD_NOTIFY_EMAIL="owner@example.com"
EMAIL_FROM="leads@yourdomain.com"

# Or SMTP fallback
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Spam protection (optional)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Uploads — production
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# MiniMax media (optional — see frontend-dev)
# MINIMAX_API_KEY=
# MINIMAX_API_BASE=

# Rate limiting (optional — Upstash)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
